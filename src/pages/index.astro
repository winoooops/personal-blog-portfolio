---
import Base from '../layouts/Base.astro';
import Starfield from '../components/Starfield.astro';
import ScopeHUD from '../components/ScopeHUD.astro';
import Corners from '../components/Corners.astro';
import Reticle from '../components/Reticle.astro';
import Hero from '../components/Hero.astro';
import ScrollCue from '../components/ScrollCue.astro';
import Manifest from '../components/Manifest.astro';
import Doctrine from '../components/Doctrine.astro';
import Projects from '../components/Projects.astro';
import Transmit from '../components/Transmit.astro';
import Reveals from '../components/Reveals.astro';
---

<Base
  title="Will Wang — Software Engineer"
  description="Software engineer working at the intersection of agentic AI and developer tooling. Based in Sydney."
>
  <Starfield />
  <ScopeHUD />
  <Corners />
  <Reticle />
  <Hero />
  <ScrollCue />
  <main class="content">
    <Manifest />
    <Doctrine />
    <Projects />
    <Transmit />
  </main>
  <Reveals />
</Base>
