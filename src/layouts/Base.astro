---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Will Wang — Software Engineer',
  description = 'Software engineer working at the intersection of agentic AI and developer tooling. Based in Sydney.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="dns-prefetch" href="https://giscus.app" />
    <title>{title}</title>
    <style>
      #page-overlay {
        position: fixed;
        inset: 0;
        background: #0e0a04;
        z-index: 9999;
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.45s ease;
      }
      #page-overlay-ring {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        /* faint full ring — provides the "circle" shape */
        border: 1px solid rgba(201, 165, 90, 0.15);
        /* bright leading arc on top */
        border-top-color: #c9a55a;
        animation: overlay-spin 1.1s linear infinite;
        position: relative;
      }
      /* tick mark at the leading edge — mirrors the cursor's tick */
      #page-overlay-ring::before {
        content: '';
        position: absolute;
        top: -5px;
        left: 50%;
        width: 1px;
        height: 5px;
        background: #c9a55a;
        transform: translateX(-50%);
      }
      @keyframes overlay-spin {
        to { transform: rotate(360deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        #page-overlay-ring { animation: none; border-top-color: rgba(201,165,90,0.5); }
        #page-overlay-ring::before { display: none; }
      }
    </style>
  </head>
  <body>
    <div id="page-overlay" aria-hidden="true">
      <div id="page-overlay-ring"></div>
    </div>
    <slot />
    <script>
      const overlay = document.getElementById('page-overlay') as HTMLElement;

      // Reveal: overlay starts opaque, fades out once DOM is ready
      document.addEventListener('DOMContentLoaded', () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          overlay.style.opacity = '0';
        }));
      });

      // Cover: fade overlay back in when an internal link is clicked
      document.addEventListener('click', e => {
        const a = (e.target as Element).closest('a[href]') as HTMLAnchorElement | null;
        if (!a) return;
        const href = a.getAttribute('href') ?? '';
        if (href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('javascript:')) return;
        try {
          const url = new URL(href, location.href);
          if (url.origin !== location.origin) return;
        } catch { return; }
        overlay.style.transition = 'opacity 0.2s ease';
        overlay.style.opacity = '1';
      });
    </script>
  </body>
</html>
