---
import TwinSunHorizon from './TwinSunHorizon.astro';
import SpiceField from './SpiceField.astro';
---

<section class="hero">
  <div class="hero-atmosphere">
    <TwinSunHorizon />
    <SpiceField count={70} seed={7} />
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      I build tools, harnesses &amp; systems for{' '}
      <span class="dune-shimmer">coding agents</span>.
    </h1>
    <p class="hero-subhead">
      Software engineer at <span class="dune-accent">Vimeflow</span>. Based in Sydney.<br />
      Working in TypeScript, Rust, Python — agentic AI, full-stack, dev tooling.
    </p>
  </div>

  <div class="hero-scroll-cue" aria-hidden="true">
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
      <path
        d="M14 4 V22 M14 22 L6 14 M14 22 L22 14"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span>Scroll · See work</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    padding: 180px var(--page-pad-x) 140px;
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1100px;
  }

  .hero-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 6.5vw, 96px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    max-width: 1000px;
  }

  .hero-subhead {
    margin: 36px 0 0;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.45;
    max-width: 720px;
  }

  .hero-scroll-cue {
    position: absolute;
    left: var(--page-pad-x);
    bottom: 56px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (max-width: 1023px) {
    .hero {
      min-height: auto;
      padding: 120px var(--page-pad-x) 100px;
    }
  }
</style>
