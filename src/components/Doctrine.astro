---
type Pillar = { num: string; sub?: string; h: string; body: string };

const pillars: Pillar[] = [
  {
    num: '001 // AGENTIC',
    h: 'AI Native.',
    body:
      'LangChain, AutoGen, MCP servers, RAG pipelines over real production data. The goal is to stop thinking like a programmer and start thinking like a designer or architect — Harness Engineering, the discipline of wrapping the model so the loop holds.',
  },
  {
    num: '002 // CRAFT',
    h: 'Code that speaks itself.',
    body:
      'TypeScript, React, Angular, Node, .NET. Refactored monoliths, modular architectures, REST and GraphQL APIs. Type-tight, test-driven, refactor-ready — the harness is only as good as the code under it.',
  },
  {
    num: '003 // INFRA',
    h: 'Cloud, by default.',
    body:
      'AWS (EC2, S3, Bedrock, Amplify), Docker, Kubernetes, GitHub Actions, TeamCity. Reusable infrastructure that supports the application without becoming the application. Cost-aware. Observable.',
  },
];
---

<section id="doctrine" class="block reveal">
  <div class="eyebrow">[ DOCTRINE ]</div>
  <h2>Three pillars.</h2>
  <div class="grid-3">
    {pillars.map((p) => (
      <article class="card">
        <div class="num">{p.num}</div>
        {p.sub && <div class="num-sub">{p.sub}</div>}
        <h3>{p.h}</h3>
        <p>{p.body}</p>
      </article>
    ))}
  </div>
</section>
