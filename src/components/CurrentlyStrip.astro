---
type Cell = {
  k: string;
  v: string;
  sub: string;
  active?: boolean;
};

const cells: Cell[] = [
  { k: 'Location', v: 'Sydney, AU', sub: 'GMT+11 · open to remote' },
  { k: 'Now', v: 'Vimeflow', sub: 'Software Engineer · 2025–', active: true },
  { k: 'Building', v: 'Lifeline + wskills', sub: 'Autonomous coding research' },
  { k: 'Status', v: 'Open to side gigs', sub: 'Dev tools, agentic systems' },
];
---

<section class="currently-strip">
  <div class="currently-grid">
    {cells.map((c, i) => (
      <div class:list={['currently-cell', i > 0 && 'has-divider']}>
        <div class="currently-meta">
          <span class:list={['currently-dot', c.active && 'is-active']} aria-hidden="true"></span>
          <span class="currently-eyebrow">{c.k}</span>
        </div>
        <div class="currently-value">{c.v}</div>
        <div class="currently-sub">{c.sub}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .currently-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .currently-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding: 32px var(--page-pad-x);
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }

  .currently-cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .currently-cell.has-divider {
    border-left: 1px solid var(--line);
    padding-left: 24px;
  }

  .currently-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .currently-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    flex: 0 0 auto;
  }

  .currently-dot.is-active {
    background: var(--accent);
    animation: duneSunPulse 1.6s ease-in-out infinite;
  }

  .currently-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .currently-value {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .currently-sub {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .currently-grid {
      grid-template-columns: 1fr 1fr;
    }
    .currently-cell.has-divider {
      border-left: none;
      padding-left: 0;
    }
    .currently-cell:nth-child(odd):not(:first-child) {
      border-top: 1px solid var(--line);
      padding-top: 16px;
    }
  }
</style>
