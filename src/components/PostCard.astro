---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const date = post.data.date.toLocaleDateString('en', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class="post-card">
  <div class="post-card-meta">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <span>{post.data.tag}</span>
    {post.data.source === 'obsidian' && <span>Obsidian</span>}
  </div>
  <h3><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
  <p>{post.data.dek}</p>
</article>
