---
import { stack } from '../data/stack';
---

<section class="stack-tools">
  <div class="stack-tools-inner">
    <div class="rail">
      <div class="rail-eyebrow">Stack</div>
      <h2 class="rail-title">Tools I reach for, by gravity.</h2>
    </div>
    <div class="stack-grid">
      {stack.map((g) => (
        <div class="stack-column">
          <div class="stack-column-head">{g.cat}</div>
          {g.items.map((it) => (
            <div class="stack-item">{it}</div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-tools {
    border-top: 1px solid var(--line);
    padding: 64px var(--page-pad-x);
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }

  .stack-tools-inner {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 64px;
  }

  .rail-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .rail-title {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 14px 0 0;
    color: var(--ink);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .stack-column {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stack-column-head {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .stack-item {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .stack-tools-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .stack-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
</style>
