---
const contactHref = import.meta.env.PUBLIC_WEB3FORMS_KEY ? '/contact/' : 'mailto:w.wang4869@gmail.com';
---

<section class="colophon">
  <div class="colophon-inner">
    <div class="rail">
      <div class="rail-eyebrow">Colophon</div>
      <h2 class="rail-title">About this site.</h2>
    </div>
    <div class="colophon-body">
      <p>
        This corner of the internet runs on Astro, lives on GitHub Pages, and is written
        mostly in Obsidian. The palette is warmed cream and terracotta, with two suns on
        the horizon — a small homage to the desert that loaned me its colors.
      </p>
      <p>
        Type is set in Inter for body and headlines, JetBrains Mono for anything that
        should feel like it belongs in a terminal. No analytics, no popups, no newsletter.
        If something here is useful or wrong,
        {' '}<a class="colophon-link" href={contactHref}>send me a note</a>.
      </p>
      <div class="colophon-credits">
        <span>Astro 5</span>
        <span aria-hidden="true">·</span>
        <span>Inter + JetBrains Mono</span>
        <span aria-hidden="true">·</span>
        <span>Hosted on Pages</span>
        <span aria-hidden="true">·</span>
        <span>Source on GitHub</span>
      </div>
    </div>
  </div>
</section>

<style>
  .colophon {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 80px var(--page-pad-x);
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }

  .colophon-inner {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 64px;
  }

  .rail-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .rail-title {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 14px 0 0;
    color: var(--ink);
  }

  .colophon-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  .colophon-body p {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0;
  }

  .colophon-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .colophon-credits {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .colophon-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
