---
// Atmospheric horizon layer for the hero — twin pulsing suns, three dunes,
// drifting silhouetted birds. SVG sized 1280×520; preserveAspectRatio crops
// to anchor dunes at the bottom regardless of hero width.
---

<svg
  class="twin-sun-horizon"
  viewBox="0 0 1280 520"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <defs>
    <radialGradient id="sunA" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fff3d6" stop-opacity="1" />
      <stop offset="40%" stop-color="#f0a040" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#f0a040" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="sunB" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffe0b8" stop-opacity="0.95" />
      <stop offset="40%" stop-color="#e8623d" stop-opacity="0.7" />
      <stop offset="100%" stop-color="#e8623d" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="haze" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f4efe6" stop-opacity="0" />
      <stop offset="100%" stop-color="#e8c89a" stop-opacity="0.5" />
    </linearGradient>
  </defs>

  <rect x="0" y="200" width="1280" height="320" fill="url(#haze)" />

  <g class="sun-a">
    <circle cx="880" cy="300" r="170" fill="url(#sunA)" />
    <circle cx="880" cy="300" r="56" fill="#f5b86a" opacity="0.85" />
  </g>

  <g class="sun-b">
    <circle cx="1020" cy="240" r="100" fill="url(#sunB)" />
    <circle cx="1020" cy="240" r="28" fill="#e8623d" opacity="0.9" />
  </g>

  <g class="birds" opacity="0.55">
    <path d="M 240 180 q 6 -6 12 0 q 6 -6 12 0" stroke="var(--ink)" stroke-width="1.2" fill="none" />
    <path d="M 320 210 q 5 -5 10 0 q 5 -5 10 0" stroke="var(--ink)" stroke-width="1.1" fill="none" />
    <path d="M 180 250 q 4 -4 8 0 q 4 -4 8 0" stroke="var(--ink)" stroke-width="1" fill="none" />
  </g>

  <path d="M 0 380 Q 200 340 420 360 T 820 360 T 1280 350 L 1280 520 L 0 520 Z" fill="var(--sand-1)" />
  <path d="M 0 420 Q 180 390 380 410 T 760 405 T 1280 400 L 1280 520 L 0 520 Z" fill="var(--sand-2)" />
  <path d="M 0 470 Q 220 450 460 460 T 880 455 T 1280 460 L 1280 520 L 0 520 Z" fill="var(--sand-3)" />

  <path
    d="M 0 380 Q 200 340 420 360 T 820 360 T 1280 350"
    stroke="#fff5e0"
    stroke-width="1.5"
    fill="none"
    opacity="0.6"
  />
</svg>

<style>
  .twin-sun-horizon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .sun-a {
    animation: duneSunPulse 9s ease-in-out infinite;
    transform-origin: 880px 300px;
  }

  .sun-b {
    animation: duneSunPulse 11s ease-in-out infinite reverse;
    transform-origin: 1020px 240px;
  }

  .birds {
    animation: duneBirdDrift 18s linear infinite;
  }
</style>
