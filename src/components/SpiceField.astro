---
interface Props {
  count?: number;
  seed?: number;
}
const { count = 70, seed = 7 } = Astro.props;
---

<canvas class="spice-field" data-count={count} data-seed={seed} aria-hidden="true"></canvas>

<style>
  .spice-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }
</style>

<script>
  // Drifting spice particles — physical motion across the hero.
  // Seeded RNG (LCG: 9301 / 49297 / 233280) gives deterministic paint
  // across reloads. Mix-blend-mode multiply blends warmly into the cream.
  type Particle = {
    x: number;
    y: number;
    r: number;
    vx: number;
    vy: number;
    wob: number;
    wobSpd: number;
    hue: string;
    alpha: number;
  };

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const count = Number(canvas.dataset.count) || 70;
    const seedInit = Number(canvas.dataset.seed) || 7;

    let s = seedInit;
    const rand = () => {
      s = (s * 9301 + 49297) % 233280;
      return s / 233280;
    };

    let parts: Particle[] = [];
    let W = 0;
    let H = 0;
    let raf = 0;

    function size() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      W = rect.width;
      H = rect.height;
    }

    function spawn() {
      parts = Array.from({ length: count }, () => ({
        x: rand() * W,
        y: rand() * H,
        r: 0.6 + rand() * 1.6,
        vx: 0.15 + rand() * 0.35,
        vy: -0.05 - rand() * 0.12,
        wob: rand() * Math.PI * 2,
        wobSpd: 0.005 + rand() * 0.012,
        hue: rand() < 0.5 ? '#c14a1a' : rand() < 0.5 ? '#e8623d' : '#b89760',
        alpha: 0.25 + rand() * 0.45,
      }));
    }

    function tick() {
      ctx!.clearRect(0, 0, W, H);
      for (const p of parts) {
        p.wob += p.wobSpd;
        p.x += p.vx + Math.sin(p.wob) * 0.18;
        p.y += p.vy + Math.cos(p.wob * 0.7) * 0.08;
        if (p.x > W + 4) {
          p.x = -4;
          p.y = rand() * H;
        }
        if (p.y < -4) {
          p.y = H + 4;
        }
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = p.hue;
        ctx!.globalAlpha = p.alpha;
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
      raf = requestAnimationFrame(tick);
    }

    size();
    spawn();
    tick();

    let resizeFrame = 0;
    function onResize() {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        cancelAnimationFrame(raf);
        s = seedInit;
        size();
        spawn();
        tick();
      });
    }
    window.addEventListener('resize', onResize);
  }

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas.spice-field');
  canvases.forEach((c) => init(c));
</script>
