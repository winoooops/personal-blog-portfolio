---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recents = allPosts.filter((p) => p.id !== featured?.id).slice(0, 4);

function formatMonth(d: Date): string {
  return d.toLocaleDateString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<section class="journal">
  <div class="journal-inner">
    <div class="journal-heading">
      <div>
        <div class="rail-eyebrow">Journal</div>
        <h2 class="rail-title">Field notes from the desert.</h2>
      </div>
      <a class="section-link" href={withBase('/blog/')}>All posts →</a>
    </div>

    {featured && (
      <a class="featured-post" href={withBase(`/blog/${featured.id}/`)}>
        <div class="featured-art" aria-hidden="true">
          <div class="featured-art-overlay"></div>
          <div class="featured-tag">Featured</div>
        </div>
        <div class="featured-body">
          <div class="featured-meta">
            {featured.data.tag} · {formatMonth(featured.data.date)} · {featured.data.readMin} min
          </div>
          <h3 class="featured-title">{featured.data.title}</h3>
          <p class="featured-dek">{featured.data.dek}</p>
          <div class="featured-cta">
            <span>Read essay</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8 H13 M9 4 L13 8 L9 12"
                stroke="var(--accent)"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
        </div>
      </a>
    )}

    <div class="recent-list">
      {recents.map((p) => (
        <a class="recent-row" href={withBase(`/blog/${p.id}/`)}>
          <span class="recent-tag">{p.data.tag}</span>
          <span class="recent-date">{formatMonth(p.data.date)}</span>
          <h4 class="recent-title">{p.data.title}</h4>
          <span class="recent-time">{p.data.readMin} min</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .journal {
    border-top: 1px solid var(--line);
    padding: 80px var(--page-pad-x);
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }

  .journal-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 36px;
  }

  .rail-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .rail-title {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ink);
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--accent);
  }

  .featured-post {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    margin-bottom: 32px;
  }

  .featured-art {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--sand-1) 0%, var(--sun-2) 50%, var(--accent) 100%);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  .featured-art-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(255, 243, 214, 0.6), transparent 50%);
  }

  .featured-tag {
    position: absolute;
    bottom: 16px;
    left: 18px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: #fff;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-meta {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.4vw, 44px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 16px;
    color: var(--ink);
  }

  .featured-dek {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: 540px;
  }

  .featured-cta {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--accent);
    font-weight: 500;
  }

  .recent-row {
    display: grid;
    grid-template-columns: 120px 100px 1fr 80px;
    align-items: baseline;
    gap: 24px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.2s ease;
    cursor: pointer;
  }

  .recent-row:hover {
    padding-left: 20px;
  }

  .recent-tag {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .recent-date {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
  }

  .recent-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .recent-row:hover .recent-title {
    color: var(--accent);
  }

  .recent-time {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 1023px) {
    .featured-post {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .recent-row {
      grid-template-columns: 100px 1fr;
      gap: 12px;
    }
    .recent-date,
    .recent-time {
      grid-column: 2 / -1;
      text-align: left;
    }
  }
</style>
