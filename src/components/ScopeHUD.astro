---
// Telescope viewport HUD — pure CSS overlay above the canvas, below the
// content. Outer hairline rectangle inset 36px, four corner brackets,
// four crosshair ticks, two rangefinder ladders, and a vignette dim.
---

<div class="scope" aria-hidden="true">
  <div class="scope-vignette"></div>
  <div class="scope-frame"></div>
  <div class="scope-corner tl"></div>
  <div class="scope-corner tr"></div>
  <div class="scope-corner bl"></div>
  <div class="scope-corner br"></div>
  <div class="scope-tick h-l"></div>
  <div class="scope-tick h-r"></div>
  <div class="scope-tick v-t"></div>
  <div class="scope-tick v-b"></div>
  <div class="scope-ladder"></div>
  <div class="scope-ladder right"></div>
</div>

<style>
  .scope {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  .scope-frame {
    position: absolute;
    inset: 36px;
    border: 1px solid rgba(201, 165, 90, 0.18);
  }
  .scope-frame::before,
  .scope-frame::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 1px;
    background: var(--gold-soft);
  }
  .scope-frame::before { top: -1px; }
  .scope-frame::after { bottom: -1px; }

  .scope-corner {
    position: absolute;
    width: 28px;
    height: 28px;
  }
  .scope-corner.tl {
    top: 10px;
    left: 10px;
    border-top: 1px solid var(--gold-soft);
    border-left: 1px solid var(--gold-soft);
  }
  .scope-corner.tr {
    top: 10px;
    right: 10px;
    border-top: 1px solid var(--gold-soft);
    border-right: 1px solid var(--gold-soft);
  }
  .scope-corner.bl {
    bottom: 10px;
    left: 10px;
    border-bottom: 1px solid var(--gold-soft);
    border-left: 1px solid var(--gold-soft);
  }
  .scope-corner.br {
    bottom: 10px;
    right: 10px;
    border-bottom: 1px solid var(--gold-soft);
    border-right: 1px solid var(--gold-soft);
  }

  .scope-tick {
    position: absolute;
    background: rgba(201, 165, 90, 0.4);
  }
  .scope-tick.h-l { top: 50%; left: 16px; width: 22px; height: 1px; }
  .scope-tick.h-r { top: 50%; right: 16px; width: 22px; height: 1px; }
  .scope-tick.v-t { left: 50%; top: 16px; width: 1px; height: 22px; }
  .scope-tick.v-b { left: 50%; bottom: 16px; width: 1px; height: 22px; }

  .scope-ladder {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 240px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 8%,
      var(--gold-soft) 8%,
      var(--gold-soft) calc(8% + 1px),
      transparent calc(8% + 1px),
      transparent 16%,
      var(--gold-soft) 16%,
      var(--gold-soft) calc(16% + 1px),
      transparent calc(16% + 1px),
      transparent 32%,
      var(--gold-soft) 32%,
      var(--gold-soft) calc(32% + 1px),
      transparent calc(32% + 1px),
      transparent 50%,
      var(--gold) 50%,
      var(--gold) calc(50% + 1px),
      transparent calc(50% + 1px),
      transparent 68%,
      var(--gold-soft) 68%,
      var(--gold-soft) calc(68% + 1px),
      transparent calc(68% + 1px),
      transparent 84%,
      var(--gold-soft) 84%,
      var(--gold-soft) calc(84% + 1px),
      transparent calc(84% + 1px),
      transparent 92%,
      var(--gold-soft) 92%,
      var(--gold-soft) calc(92% + 1px),
      transparent calc(92% + 1px)
    );
    opacity: 0.7;
  }
  .scope-ladder.right {
    left: auto;
    right: 16px;
  }

  .scope-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(10, 7, 3, 0.55) 100%);
  }
</style>
