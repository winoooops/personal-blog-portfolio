---
import { works } from '../data/work';
---

<section class="selected-work">
  <div class="selected-work-inner">
    <div class="section-heading">
      <h2 class="section-title">
        Selected Work <span class="section-title-year">'26</span>
      </h2>
      <a class="section-link" href="#">All projects →</a>
    </div>

    <div class="work-list">
      {works.map((w) => (
        <a class="work-row" href={w.href}>
          <div class="work-left">
            <div class="work-meta">
              <span class:list={['work-dot', `dot-${w.dot}`]} aria-hidden="true"></span>
              <span class="work-meta-label">{w.co} · '{w.yr} · {w.status}</span>
            </div>
            <h3 class="work-title">{w.title}</h3>
            <p class="work-line">{w.line}</p>
            <ul class="work-tags" aria-label={`Stack for ${w.title}`}>
              {w.tags.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <svg class="work-arrow" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
            <circle cx="22" cy="22" r="21" stroke="var(--line)" fill="transparent" />
            <path
              d="M16 22 H28 M22 16 L28 22 L22 28"
              stroke="var(--ink)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .selected-work {
    padding: 48px var(--page-pad-x) 80px;
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
  }

  .section-title-year {
    color: var(--muted);
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--accent);
  }

  .work-list {
    border-top: 1px solid var(--line);
  }

  .work-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 32px;
    padding: 36px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.2s ease, color 0.2s ease;
    cursor: pointer;
  }

  .work-row:hover {
    padding-left: 24px;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .work-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .work-dot.dot-accent {
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 13%, transparent);
  }
  .work-dot.dot-sun-1 {
    background: var(--sun-1);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sun-1) 13%, transparent);
  }
  .work-dot.dot-sun-2 {
    background: var(--sun-2);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sun-2) 13%, transparent);
  }
  .work-dot.dot-sand-3 {
    background: var(--sand-3);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sand-3) 13%, transparent);
  }
  .work-dot.dot-muted {
    background: var(--muted);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--muted) 13%, transparent);
  }

  .work-meta-label {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .work-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .work-row:hover .work-title {
    color: var(--accent);
  }

  .work-line {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: 17px;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: 720px;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .work-tags li {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-soft);
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .work-arrow {
    flex-shrink: 0;
    align-self: center;
  }

  @media (max-width: 1023px) {
    .work-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .work-arrow {
      align-self: flex-start;
    }
  }
</style>
