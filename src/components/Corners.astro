---
import Menu from './Menu.astro';
---

<div class="corner tl">
  <div class="name">W.W. NAVIGATOR</div>
  <div><span class="label">SYSTEM STATUS:</span> SHIPPING [98.2%]</div>
  <div><span class="label">COORDINATES:</span> 33°52'S 151°12'E</div>
</div>

<div class="corner tr">
  <Menu />
</div>

<div class="corner bl">
  <div>ESTABLISHED // SYDNEY 2018</div>
  <div>ALL RIGHTS RESERVED // © 2026 W. WANG</div>
</div>

<div class="corner br">
  <div>v1.0 // BUILD 4216</div>
</div>

<style>
  .corner {
    position: fixed;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    line-height: 1.8;
    z-index: 10;
    font-family: var(--font-mono);
  }
  .tl { top: 52px; left: 56px; }
  .bl { bottom: 52px; left: 56px; color: var(--gold-soft); }
  .tr { top: 52px; right: 80px; }
  .br { bottom: 52px; right: 56px; color: var(--gold-soft); }

  .corner .label {
    color: var(--gold-soft);
  }

  .corner .name {
    font-size: 13px;
    letter-spacing: 0.32em;
  }

  /* Below ~1500px, the content max-width (1280px) is too close to the
   * corner text, so they overlap. Hide the decorative text corners and
   * keep only the TR menu (still needed for navigation). The mobile
   * breakpoint at 1023px in other components handles the rest. */
  @media (max-width: 1500px) {
    .corner.tl,
    .corner.bl,
    .corner.br {
      display: none;
    }
  }
</style>
