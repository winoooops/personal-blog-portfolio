    {"id": "caption", "type": "text", "text": "Same triangle, different process boundaries.\nPaired mode wins because the reviewer cannot rationalize the coder's mistakes — it has no stake in the existing work.", "x": -250, "y": 80, "width": 720, "height": 90}
